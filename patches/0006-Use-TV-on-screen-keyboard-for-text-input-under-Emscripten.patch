From 15c541bfb37a3b93b4a50298f807c08257f23e24 Mon Sep 17 00:00:00 2001
From: copilot <c@x>
Date: Sat, 31 Oct 2026 09:08:21 +0100
Subject: [PATCH] Add on-screen keyboard for save names under Emscripten

---
 src/i_input.c  | 36 ++++++++++++++++++++++++++++++++++++
 src/i_system.c |  8 ++++++++
 2 files changed, 44 insertions(+)

diff --git a/src/i_input.c b/src/i_input.c
index 091aa6b8..f3c47676 100644
--- a/src/i_input.c
+++ b/src/i_input.c
@@ -18,6 +18,10 @@
 
 #include <string.h>
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
 #include "SDL.h"
 #include "SDL_keycode.h"
 
@@ -28,6 +32,25 @@
 #include "m_argv.h"
 #include "m_config.h"
 
+#ifdef __EMSCRIPTEN__
+// Injects a key press from the TV on-screen keyboard (called from index.html).
+// Lives here because i_input.c is only built into the game binaries, which
+// are the only ones that link d_event.c (D_PostEvent).
+EMSCRIPTEN_KEEPALIVE void doom_post_key (int key)
+{
+    event_t event;
+
+    event.type = ev_keydown;
+    event.data1 = key;
+    event.data2 = 0;
+    event.data3 = key;
+    D_PostEvent(&event);
+
+    event.type = ev_keyup;
+    D_PostEvent(&event);
+}
+#endif
+
 static const int scancode_translate_table[] = SCANCODE_TO_KEYS_ARRAY;
 
 // Lookup table for mapping ASCII characters to their equivalent when
@@ -294,6 +317,13 @@ void I_StartTextInput(int x1, int y1, int x2, int y2)
         // SDL2-TODO: SDL_SetTextInputRect(...);
         SDL_StartTextInput();
     }
+
+#ifdef __EMSCRIPTEN__
+    // Focus the hidden <input> in index.html so the TV shows its on-screen keyboard.
+    EM_ASM({
+        if (typeof doomTextInputStart === 'function') doomTextInputStart();
+    });
+#endif
 }
 
 void I_StopTextInput(void)
@@ -304,6 +334,12 @@ void I_StopTextInput(void)
     {
         SDL_StopTextInput();
     }
+
+#ifdef __EMSCRIPTEN__
+    EM_ASM({
+        if (typeof doomTextInputStop === 'function') doomTextInputStop();
+    });
+#endif
 }
 
 static void UpdateMouseButtonState(unsigned int button, boolean on)
diff --git a/src/i_system.c b/src/i_system.c
index cbf9afaf..a652801a 100644
--- a/src/i_system.c
+++ b/src/i_system.c
@@ -34,6 +34,7 @@
 
 #include "config.h"
 
+#include "d_event.h"
 #include "deh_str.h"
 #include "doomtype.h"
 #include "m_argv.h"
@@ -61,6 +62,13 @@ EMSCRIPTEN_KEEPALIVE int doom_get_frames (void)
 {
     return doom_frames;
 }
+
+// Weak no-op so non-game targets (no d_event.c) still satisfy the global
+// EXPORTED_FUNCTIONS list; the game binaries override it in i_input.c.
+__attribute__((weak)) EMSCRIPTEN_KEEPALIVE void doom_post_key (int key)
+{
+    (void)key;
+}
 #endif
 
 

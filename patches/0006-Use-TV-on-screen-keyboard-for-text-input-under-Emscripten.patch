+#ifdef __EMSCRIPTEN__
+EMSCRIPTEN_KEEPALIVE void doom_post_key (int key)
+{
+    event_t event;
+
+    event.type = ev_keydown;
+    event.data1 = key;
+    event.data2 = 0;
+    event.data3 = key;
+    D_PostEvent(&event);
+
+    event.type = ev_keyup;
+    D_PostEvent(&event);
+}

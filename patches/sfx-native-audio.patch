 static allocated_sound_t *channels_playing[NUM_CHANNELS];
 
+// Per-channel playback state for the native SDL audio mixer.
+
+static int channel_positions[NUM_CHANNELS];
+static int channel_left_vol[NUM_CHANNELS];
+static int channel_right_vol[NUM_CHANNELS];
+static SDL_AudioDeviceID sfx_audio_device = 0;
+
+// Mix all playing channels into the output buffer (S16 -> F32).
+// The Emscripten SDL2 audio driver only supports F32.
+
+static void SFX_AudioCallback(void *userdata, Uint8 *stream, int len)
+{
+    float *dst = (float *) stream;
+    int frames = len / (2 * sizeof(float));
+    int c;
+
+    memset(stream, 0, len);
+
+    for (c = 0; c < NUM_CHANNELS; ++c)
+    {
+        allocated_sound_t *snd = channels_playing[c];
+        Sint16 *src;
+        int src_frames;
+        int f;
+
+        if (snd == NULL)
+        {
+            continue;
+        }
+
+        src = (Sint16 *) snd->chunk.abuf;
+        src_frames = (int) (snd->chunk.alen / (2 * sizeof(Sint16)));
+
+        for (f = 0; f < frames; ++f)
+        {
+            int pos = channel_positions[c];
+
+            if (pos >= src_frames)
+            {
+                break;
+            }
+
+            dst[f * 2] += (float) src[pos * 2] * channel_left_vol[c] / (255.0f * 32768.0f);
+            dst[f * 2 + 1] += (float) src[pos * 2 + 1] * channel_right_vol[c] / (255.0f * 32768.0f);
+
+            channel_positions[c] = pos + 1;
+        }
+    }
+}

From 47dd343ed9478ec7228eadfac8bc19130b95507d Mon Sep 17 00:00:00 2001
From: Dennis <ostermann3k@googlemail.com>
Date: Thu, 29 Oct 2026 13:35:48 +0100
Subject: [PATCH] Fix OPL music hang and detection failure under Emscripten

The OPL timer only advances in the SDL audio callback, which runs on the browser main thread. Synchronous OPL detection and OPL_Delay therefore never complete. Skip the wait under __EMSCRIPTEN__ and assume an OPL3 chip is present.

Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>
---
 opl/opl.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/opl/opl.c b/opl/opl.c
index e99821cb..4a2979ca 100644
--- a/opl/opl.c
+++ b/opl/opl.c
@@ -281,6 +281,12 @@ opl_init_result_t OPL_Detect(void)
     int result1, result2;
     int i;
 
+#ifdef __EMSCRIPTEN__
+    // The OPL timer only advances in the audio callback, which cannot run
+    // during this synchronous detection, so assume an OPL3 is present.
+    return OPL_INIT_OPL3;
+#endif
+
     // Reset both timers:
     OPL_WriteRegister(OPL_REG_TIMER_CTRL, 0x60);
 
@@ -478,6 +484,12 @@ void OPL_Delay(uint64_t us)
         return;
     }
 
+#ifdef __EMSCRIPTEN__
+    // The audio callback runs on the browser main thread, so blocking
+    // here would prevent it from ever firing.
+    return;
+#endif
+
     // Create a callback that will signal this thread after the
     // specified time.
 
